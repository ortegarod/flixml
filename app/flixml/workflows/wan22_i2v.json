{
  "90": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{high_model}}",
      "weight_dtype": "default"
    }
  },
  "91": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "{{low_model}}",
      "weight_dtype": "default"
    }
  },
  "38": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "wan",
      "device": "default"
    }
  },
  "39": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["38", 0]
    }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": ["38", 0]
    }
  },
  "62": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    }
  },
  "93": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": ["62", 0]
    }
  },
  "94": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "floor(sqrt(921600 * a / b) / 16) * 16",
      "values.a": ["93", 0],
      "values.b": ["93", 1]
    }
  },
  "95": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "floor(sqrt(921600 * b / a) / 16) * 16",
      "values.a": ["93", 0],
      "values.b": ["93", 1]
    }
  },
  "92": {
    "class_type": "ImageScale",
    "inputs": {
      "image": ["62", 0],
      "upscale_method": "bicubic",
      "width": ["94", 1],
      "height": ["95", 1],
      "crop": "disabled"
    }
  },
  "63": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["39", 0],
      "start_image": ["92", 0],
      "width": ["94", 1],
      "height": ["95", 1],
      "length": "{{length}}",
      "batch_size": 1
    }
  },
  "80": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["90", 0],
      "lora_name": "{{high_lora}}",
      "strength_model": "{{high_lora_strength}}"
    }
  },
  "82": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["91", 0],
      "lora_name": "{{low_lora}}",
      "strength_model": "{{low_lora_strength}}"
    }
  },
  "54": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["86", 0],
      "shift": "{{shift}}"
    }
  },
  "55": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": ["87", 0],
      "shift": "{{shift}}"
    }
  },
  "100": {
    "_meta": {
      "title": "Context windows (high noise) - dropped when the clip fits one window"
    },
    "class_type": "ContextWindowsManual",
    "inputs": {
      "model": ["54", 0],
      "context_length": "{{context_length}}",
      "context_overlap": "{{context_overlap}}",
      "context_schedule": "{{context_schedule}}",
      "context_stride": 1,
      "closed_loop": false,
      "fuse_method": "{{fuse_method}}",
      "dim": 2,
      "freenoise": true,
      "cond_retain_index_list": "{{cond_retain_index_list}}",
      "split_conds_to_windows": false,
      "latent_retain_index_list": "",
      "causal_window_fix": true
    }
  },
  "101": {
    "_meta": {
      "title": "Context windows (low noise) - dropped when the clip fits one window"
    },
    "class_type": "ContextWindowsManual",
    "inputs": {
      "model": ["55", 0],
      "context_length": "{{context_length}}",
      "context_overlap": "{{context_overlap}}",
      "context_schedule": "{{context_schedule}}",
      "context_stride": 1,
      "closed_loop": false,
      "fuse_method": "{{fuse_method}}",
      "dim": 2,
      "freenoise": true,
      "cond_retain_index_list": "{{cond_retain_index_list}}",
      "split_conds_to_windows": false,
      "latent_retain_index_list": "",
      "causal_window_fix": true
    }
  },
  "57": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "enable",
      "noise_seed": "{{seed}}",
      "control_after_generate": "randomize",
      "steps": "{{total_steps}}",
      "cfg": "{{cfg_high}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "start_at_step": 0,
      "end_at_step": "{{steps_high}}",
      "return_with_leftover_noise": "enable",
      "model": ["100", 0],
      "positive": ["63", 0],
      "negative": ["63", 1],
      "latent_image": ["63", 2]
    }
  },
  "58": {
    "class_type": "KSamplerAdvanced",
    "inputs": {
      "add_noise": "disable",
      "noise_seed": 0,
      "control_after_generate": "fixed",
      "steps": "{{total_steps}}",
      "cfg": "{{cfg_low}}",
      "sampler_name": "{{sampler}}",
      "scheduler": "{{scheduler}}",
      "start_at_step": "{{steps_high}}",
      "end_at_step": 10000,
      "return_with_leftover_noise": "disable",
      "model": ["101", 0],
      "positive": ["63", 0],
      "negative": ["63", 1],
      "latent_image": ["57", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["58", 0],
      "vae": ["39", 0]
    }
  },
  "96": {
    "class_type": "RIFE VFI",
    "inputs": {
      "frames": ["8", 0],
      "ckpt_name": "rife49.pth",
      "clear_cache_after_n_frames": 10,
      "multiplier": 2,
      "fast_mode": true,
      "ensemble": true,
      "scale_factor": 1.0,
      "dtype": "float32",
      "torch_compile": false,
      "batch_size": 1
    }
  },
  "60": {
    "class_type": "CreateVideo",
    "inputs": {
      "fps": "{{fps}}",
      "images": ["96", 0]
    }
  },
  "61": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "{{filename_prefix}}",
      "format": "auto",
      "codec": "h264",
      "video": ["60", 0]
    }
  },
