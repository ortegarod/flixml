{
  "1": {"class_type": "LoadVideo", "inputs": {"file": "{{video}}"}},
  "3": {"class_type": "GetVideoComponents", "inputs": {"video": ["1", 0]}},
  "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{sam3_model}}"}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["4", 1]}},
  "6": {"class_type": "SAM3_VideoTrack", "inputs": {"images": ["3", 0], "model": ["4", 0], "conditioning": ["5", 0], "detection_threshold": 0.5, "max_objects": "{{max_objects}}", "detect_interval": 1}},
  "7": {"class_type": "SAM3_TrackToMask", "inputs": {"track_data": ["6", 0], "object_indices": ""}},
  "8": {"class_type": "MaskToImage", "inputs": {"mask": ["7", 0]}},
  "9": {"class_type": "CreateVideo", "inputs": {"images": ["8", 0], "fps": ["3", 2]}},
  "10": {"class_type": "SaveVideo", "inputs": {"video": ["9", 0], "filename_prefix": "{{filename_prefix}}", "format": "auto", "codec": "auto"}}
}
