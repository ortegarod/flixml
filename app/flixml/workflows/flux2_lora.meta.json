{
  "id": "flux2_lora",
  "name": "FLUX.2 + LoRA Image",
  "description": "Text-to-image with FLUX.2 plus one or more trained character LoRAs — a consistent identity rendered at high fidelity from a prompt.",
  "task": "text-to-image",
  "output_type": "image",
  "requirements": {
    "vram_gb": 24,
    "model_files_gb": 48.1,
    "workflow_type": "flux2",
    "supports_lora": true,
    "notes": "TESTED 2026-09-07 on RTX 4070 Ti (12 GB) + 16 GB system RAM. FLUX.2-dev is ~32B: the fp8 weights are 35 GB plus a 12 GB text encoder, far more than that machine's GPU memory and RAM combined, so weights spill to disk. Real timing: 32 min @24 steps, 15 min @8-step turbo, 18 min with Q3_K_S GGUF + turbo. Untested with more system RAM or a 24 GB+ GPU (e.g. RunPod); both reduce spilling. For fast local iteration use SDXL and composite text separately."
  },
  "params": {
    "prompt": {
      "type": "str",
      "required": true,
      "description": "Text prompt"
    },
    "loras": {
      "type": "list",
      "required": false,
      "description": "List of LoRA specs"
    },
    "lora_strength": {
      "type": "float",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    "width": {
      "type": "int",
      "default": 1248,
      "description": "Output width"
    },
    "height": {
      "type": "int",
      "default": 832,
      "description": "Output height"
    },
    "seed": {
      "type": "int",
      "required": false,
      "description": "Random seed (auto if omitted)"
    },
    "steps": {
      "type": "int",
      "default": 20,
      "min": 1,
      "max": 50
    },
    "cfg": {
      "type": "float",
      "default": 4.0,
      "min": 1.0,
      "max": 20.0
    },
    "sampler": {
      "type": "str",
      "default": "euler"
    },
    "guidance": {
      "type": "float",
      "default": 4.0,
      "description": "FLUX guidance scale"
    },
    "unet": {
      "type": "str",
      "default": "flux2_dev_fp8mixed.safetensors"
    },
    "clip": {
      "type": "str",
      "default": "mistral_3_small_flux2_fp4_mixed.safetensors"
    },
    "vae": {
      "type": "str",
      "default": "flux2-vae.safetensors"
    }
  },
  "compatible_providers": [
    "local",
    "cloud_serverless"
  ],
  "examples": []
}
