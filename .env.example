# FlixML Studio — environment variables
# Copy this to .env and fill in your values.

FLIXML_API_URL=http://127.0.0.1:8191
DATABASE_URL=postgresql://user:password@localhost:5432/flixml_studio
FLIXML_OUTPUT_DIR=./outputs

# LoRA training folders. The API won't start without these three.
FLIXML_TRAINING_DIR=./training
FLIXML_LORA_OUTPUT_DIR=./training/output
FLIXML_COMFY_LORA_DIR=/path/to/ComfyUI/models/loras

# AI Toolkit (ostris/ai-toolkit) UI on the machine that trains. AITK_API_TOKEN is the
# AI_TOOLKIT_AUTH value it was started with.
AITK_API_URL=http://<trainer-host>:8675
AITK_API_TOKEN=
AITK_GPU_IDS=0

# Voice for /api/tts/generate. The key is the secret shown once when you create it
# (starts with sk_), not the key ID the list page shows. The voice id is the default
# when a request names no voice; GET /api/tts/voices lists what your account has.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
