# FlixML Studio — environment variables
# Copy this to .env and fill in your values.

FLIXML_API_URL=http://127.0.0.1:8191
DATABASE_URL=postgresql://user:password@localhost:5432/flixml_studio
FLIXML_OUTPUT_DIR=./outputs

# LoRA training folders. The API won't start without these three.
FLIXML_TRAINING_DIR=./training
FLIXML_LORA_OUTPUT_DIR=./training/output
FLIXML_COMFY_LORA_DIR=/path/to/ComfyUI/models/loras

# ai-toolkit runs on the training droplet. Example: http://<droplet-ip>:8675
AITK_API_URL=http://<droplet-ip>:8675
AITK_API_TOKEN=
AITK_GPU_IDS=0

# Disposable DigitalOcean training droplet lifecycle.
# Region is an app default, not an environment variable.
DIGITALOCEAN_TOKEN=
TRAINING_CLOUD_SIZE=gpu-mi300x1-192gb
TRAINING_CLOUD_IMAGE=gpu-amd-base
TRAINING_CLOUD_TTL_HOURS=12
TRAINING_CLOUD_REPO_URL=https://github.com/ortegarod/flixml.git
# Comma-separated DigitalOcean SSH key IDs or fingerprints installed on the droplet.
TRAINING_CLOUD_SSH_KEYS=

ELEVENLABS_API_KEY=
